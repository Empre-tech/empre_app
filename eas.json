{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "610757440726-alpf1ein951vs9tqkek01lnb905mbbi3.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "610757440726-huba2mai3bqoaksnjnj4s38lqp6kttik.apps.googleusercontent.com"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.empre.com.co",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "610757440726-alpf1ein951vs9tqkek01lnb905mbbi3.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "610757440726-huba2mai3bqoaksnjnj4s38lqp6kttik.apps.googleusercontent.com"
      },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.empre.com.co",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "610757440726-alpf1ein951vs9tqkek01lnb905mbbi3.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "610757440726-huba2mai3bqoaksnjnj4s38lqp6kttik.apps.googleusercontent.com"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
